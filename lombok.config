# Lombok is used for the accessors of the configuration beans and nothing else.
config.stopBubbling = true

# Marks generated accessors @lombok.Generated so JaCoCo leaves them out of the gate;
# an accessor nobody wrote is not coverage anyone should chase.
lombok.addLombokGeneratedAnnotation = true

# Keep the nullability contract on the generated accessor, not only on the field it came from.
lombok.copyableAnnotations += io.micronaut.core.annotation.Nullable
lombok.copyableAnnotations += io.micronaut.core.annotation.NonNull
