<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback configuration for the Consent Manager.

  All log output is written as structured JSON to stdout using the
  logstash-logback-encoder, suitable for container-based deployments
  where a log aggregator (ELK, Loki, etc.) ingests stdout.

  No file appenders or rotation — the container platform is responsible
  for log retention and rotation.
-->
<configuration>

    <!-- ================================================================== -->
    <!-- Console appender: structured JSON to stdout                        -->
    <!-- ================================================================== -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!--
              Include the MDC 'correlationId' field in every log line.
              The CorrelationIdFilter sets this for each HTTP request.
            -->
            <includeMdcKeyName>correlationId</includeMdcKeyName>

            <!-- Use shorter field names for readability -->
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
            </fieldNames>

            <!-- Include caller info only for ERROR level (performance trade-off) -->
            <includeCallerData>false</includeCallerData>
        </encoder>
    </appender>

    <!-- ================================================================== -->
    <!-- Log levels                                                         -->
    <!-- ================================================================== -->

    <!-- Application: INFO for production visibility -->
    <logger name="com.seamware.consentmanager" level="INFO" />

    <!-- Framework internals: WARN to reduce noise -->
    <logger name="io.micronaut" level="WARN" />
    <logger name="io.netty" level="WARN" />
    <logger name="org.flywaydb" level="INFO" />
    <logger name="com.zaxxer.hikari" level="WARN" />

    <!-- Root logger: INFO as a sensible default -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

</configuration>
