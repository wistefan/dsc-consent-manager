# =============================================================================
# Consent Manager — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# Variables marked [required] have no default and must be set in production.
# Variables marked [optional] have sensible defaults shown after the '='.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# HTTP port the service listens on [optional, default: 8080]
PORT=8080

# Context path prefix for all API endpoints [optional, default: /v1]
API_PREFIX=/v1

# Port for management endpoints (health, metrics, prometheus) [optional, default: 9090]
MANAGEMENT_PORT=9090

# Active Micronaut environments, comma-separated [optional]
# Set to "dev" for local development with relaxed security
MICRONAUT_ENVIRONMENTS=dev

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------

# JDBC connection URL [required in production]
DB_URL=jdbc:postgresql://localhost:5432/consent_manager

# Database username [required in production]
DB_USER=consent_manager

# Database password [required in production]
DB_PASSWORD=consent_manager

# -----------------------------------------------------------------------------
# Service URLs
# -----------------------------------------------------------------------------

# Public base URL of this Consent Manager instance [required in production]
CONSENT_MANAGER_URL=http://localhost:8080

# Base URL of the Contract Service [required in production]
CONTRACT_SERVICE_URL=http://localhost:8081

# -----------------------------------------------------------------------------
# Identity Provider (OAuth2 / OIDC)
# -----------------------------------------------------------------------------

# The Consent Manager is a stateless OAuth2 *resource server*. It issues no tokens
# and holds no client credentials, so there is deliberately no IDP_CLIENT_ID or
# IDP_CLIENT_SECRET here.
#
# A trusted provider is described by two configuration blocks sharing one name:
#
#   micronaut.security.oauth2.clients.<name>.openid.issuer
#       The issuer URL. From it alone Micronaut Security fetches the provider's
#       OpenID discovery document, reads its jwks_uri and caches the signing
#       keys, re-fetching them when the cache expires - so key rotation needs no
#       restart and no discovery URL has to be configured separately.
#
#   consent-manager.identity-providers.<name>
#       This service's audience, clock skew, claim paths and role mapping for
#       that issuer - the per-provider settings Micronaut cannot express.
#
# A name present in only one of the two blocks aborts startup, as does an empty
# trust list. The list is read ONCE at startup and is immutable for the lifetime
# of the process; changing a provider requires a restart.
#
# The variables below configure the single default entry, which is named
# `primary`. IDP_ISSUER and IDP_AUDIENCE are commented out on purpose: leaving
# them unset aborts startup with a message naming the missing property, which is
# safer than a copied .env silently trusting a localhost issuer.
#
# Adding a SECOND provider is NOT possible through environment variables.
# Micronaut registers CONSENT_MANAGER_IDENTITY_PROVIDERS_1_ISSUER verbatim as
# `CONSENT_MANAGER_IDENTITY_PROVIDERS[1]ISSUER`, which never normalises to a
# bindable property - the entry is ignored without any error - and a named entry
# whose leaf keys are separated by underscores is ambiguous in the same way. Use
# one of these instead:
#   * mount a YAML file adding further named entries to BOTH blocks:
#       MICRONAUT_CONFIG_FILES=/etc/consent-manager/identity-providers.yml
#   * or pass system properties:
#       -Dmicronaut.security.oauth2.clients.other.openid.issuer=https://...
#       -Dconsent-manager.identity-providers.other.audience=consent-manager

# Issuer URL of the `primary` provider - must match the token's `iss` claim and
# the `issuer` field of the provider's discovery document byte for byte
# [required in production]
# IDP_ISSUER=http://localhost:8180/realms/consent-manager

# Audience this service expects in the token's `aud` claim [required in production]
# IDP_AUDIENCE=consent-manager

# Tolerance applied to the exp, iat and nbf claims [optional, default: 30s]
# IDP_CLOCK_SKEW=30s

# Claim carrying the opaque user identifier. May be a dot-separated nested path.
# [optional, default: sub]
# IDP_CLAIM_USER_IDENTIFIER=sub

# Claim carrying the opaque participant identifier [optional, default: participant_id]
# IDP_CLAIM_PARTICIPANT_IDENTIFIER=participant_id

# Claim carrying the token's raw role strings [optional, default: realm_access.roles]
# IDP_CLAIM_ROLES=realm_access.roles

# Raw role strings this provider emits, mapped to the service's roles. Matching is
# exact and case-sensitive. [optional, defaults shown]
# IDP_ROLE_USER=consent-user
# IDP_ROLE_PARTICIPANT=consent-participant
# IDP_ROLE_CATALOG=consent-catalog

# -----------------------------------------------------------------------------
# Local Keycloak (docker compose only)
# -----------------------------------------------------------------------------
# Consumed solely by the `keycloak` service in compose.yaml. The deployed service
# never reads these; it only ever talks to the issuer configured above.

# Port the local Keycloak listens on [optional, default: 8180]
# KEYCLOAK_PORT=8180

# Bootstrap admin credentials for the local Keycloak console [optional, default: admin]
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Consent Signing
# -----------------------------------------------------------------------------

# Path to the private key used for signing consent documents [required in production]
# CONSENT_SIGNING_KEY_PATH=/etc/consent-manager/keys/signing.pem

# -----------------------------------------------------------------------------
# Email / SMTP
# -----------------------------------------------------------------------------

# SMTP server host [required when email notifications are enabled]
# SMTP_HOST=smtp.example.com

# SMTP server port [optional, default: 587]
# SMTP_PORT=587

# SMTP authentication username [required when email notifications are enabled]
# SMTP_USER=

# SMTP authentication password [required when email notifications are enabled]
# SMTP_PASSWORD=

# Sender email address for outgoing notifications [required when email notifications are enabled]
# SMTP_FROM=noreply@example.com
