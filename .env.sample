# =============================================================================
# Consent Manager — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# Variables marked [required] have no default and must be set in production.
# Variables marked [optional] have sensible defaults shown after the '='.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# HTTP port the service listens on [optional, default: 8080]
PORT=8080

# Context path prefix for all API endpoints [optional, default: /v1]
API_PREFIX=/v1

# Port for management endpoints (health, metrics, prometheus) [optional, default: 9090]
MANAGEMENT_PORT=9090

# Active Micronaut environments, comma-separated [optional]
# Set to "dev" for local development against the compose stack. Note that `dev`
# does NOT relax authentication: security stays enabled and the trust list below
# is still enforced. It only points the trust list at the local Keycloak, waives
# Micronaut's endpoint-level `sensitive` check on /metrics and /prometheus (the
# intercept-url-map still guards them) and turns off OpenTelemetry tracing.
MICRONAUT_ENVIRONMENTS=dev

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------

# JDBC connection URL [required in production]
DB_URL=jdbc:postgresql://localhost:5432/consent_manager

# Database username [required in production]
DB_USER=consent_manager

# Database password [required in production]
DB_PASSWORD=consent_manager

# -----------------------------------------------------------------------------
# Service URLs
# -----------------------------------------------------------------------------

# Public base URL of this Consent Manager instance [required in production]
CONSENT_MANAGER_URL=http://localhost:8080

# Base URL of the Contract Service [required in production]
CONTRACT_SERVICE_URL=http://localhost:8081

# Bounds on one attempt against the Contract Service, not on a whole fetch. A
# fetch is bounded by (CONTRACT_SERVICE_RETRY_ATTEMPTS + 1) x the read timeout
# plus the growing retry pauses - about 23.5s at the defaults - and by twice
# that when the ecosystem endpoint misses and the bilateral one is tried too.
# Size a caller's own timeout from that bound, not from the read timeout
# [optional, defaults: 2s / 5s]
# CONTRACT_SERVICE_CONNECT_TIMEOUT=2s
# CONTRACT_SERVICE_READ_TIMEOUT=5s

# Retries after a failed contract fetch, counted after the initial attempt, and the
# growing pause between them - 3 retries are at most 4 upstream requests, and 1 is the
# smallest budget accepted. Only a 5xx or a transport failure is retried; a 4xx is a
# defect retrying cannot fix [optional, defaults: 3 / 500ms / 2.0]
# CONTRACT_SERVICE_RETRY_ATTEMPTS=3
# CONTRACT_SERVICE_RETRY_DELAY=500ms
# CONTRACT_SERVICE_RETRY_MULTIPLIER=2.0

# How long a fetched contract is served from cache. This is not a latency knob:
# a notice is generated from the cached document, so it is how stale the contract
# behind a freshly published notice may be, and how long a contract change stays
# invisible to a repeated generation. Keep it short [optional, default: 60s]
# CONTRACT_SERVICE_CACHE_TTL=60s

# Contracts held in that cache before the least recently used one is dropped
# [optional, default: 1000]
# CONTRACT_SERVICE_CACHE_MAX_SIZE=1000

# -----------------------------------------------------------------------------
# Catalog self-descriptions
# -----------------------------------------------------------------------------
# Read only by GET /privacy-notices/{id}?resolve=true, from absolute URLs that
# come out of a contract this service does not own.

# Hosts a self-description may be fetched from, comma-separated. Empty - the
# default - admits any host whose addresses all lie outside this network. An
# entry does double duty: it restricts fetching to the listed hosts AND waives
# the private-address refusal for them, because naming a host here is a
# statement about your own network. Operator configuration only: a participant
# that self-registers is never added here, or it could grant itself the
# private-address waiver [optional, default: empty]
# SELF_DESCRIPTION_ALLOWED_HOSTS=catalog.example.org

# Documents one resolved retrieval reads before it stops walking the catalog
# and reports the data section UNAVAILABLE. The walk is over lists this service
# does not author, so without a ceiling one GET fans out as far as whoever
# publishes them decides [optional, default: 50]
# SELF_DESCRIPTION_MAX_DOCUMENTS=50

# Longest one resolved retrieval spends walking the catalog before it stops and
# reports the data section UNAVAILABLE. The companion of
# SELF_DESCRIPTION_MAX_DOCUMENTS, not a duplicate: a document ceiling bounds how
# many reads a retrieval makes, not how long each one sits out the read timeout
# [optional, default: 15s]
# SELF_DESCRIPTION_MAX_DURATION=15s

# Whether a self-description may be read over plain http. Leave false in
# production: plaintext would let whoever sees that traffic rewrite what a
# published notice says [optional, default: false]
# SELF_DESCRIPTION_ALLOW_PLAINTEXT_HTTP=false

# How long a fetched self-description is served from cache. May be longer than
# CONTRACT_SERVICE_CACHE_TTL: a catalog document carries a title and a
# description rather than the terms a notice is published under, so staleness
# here costs a label and not a legal statement [optional, default: 10m]
# SELF_DESCRIPTION_CACHE_TTL=10m

# Documents held in that cache before the least recently used one is dropped
# [optional, default: 1000]
# SELF_DESCRIPTION_CACHE_MAX_SIZE=1000

# -----------------------------------------------------------------------------
# User directory
# -----------------------------------------------------------------------------

# Most users POST /users/search returns; the operation is not paginated
# [optional, default: 200]
# USERS_SEARCH_MAX_RESULTS=200

# Most entries POST /participants/me/users/bulk may carry; a larger batch is
# refused whole, before anything is written
# [optional, default: 500]
# USERS_BULK_MAX_SIZE=500

# Records GET /participants returns when the caller names no size
# [optional, default: 20]
# PARTICIPANTS_PAGE_DEFAULT_SIZE=20

# Most records one GET /participants page may carry; a larger requested size is
# clamped to this rather than refused
# [optional, default: 100]
# PARTICIPANTS_PAGE_MAX_SIZE=100

# Records GET /consents/me returns when the caller names no size
# [optional, default: 20]
# CONSENTS_PAGE_DEFAULT_SIZE=20

# Most records one GET /consents/me page may carry; a larger requested size is
# clamped to this rather than refused
# [optional, default: 100]
# CONSENTS_PAGE_MAX_SIZE=100

# Contracts one GET /contracts/available listing reads from the Contract Service
# at once
# [optional, default: 8]
# CONTRACT_DISCOVERY_MAX_CONCURRENCY=8

# Longest one GET /contracts/available listing waits on the Contract Service
# before answering 502 with no partial list
# [optional, default: 30s]
# CONTRACT_DISCOVERY_MAX_DURATION=30s

# Jurisdiction a Kantara consent receipt (format=receipt-kantara) names as
# governing the processing; neither a notice nor a contract carries one
# [optional, default: EU]
# RECEIPTS_JURISDICTION=EU

# Private JSON Web Key (one line of RFC 7517 JSON, EC or RSA) every consent
# receipt is signed with; its public half is published at the origin root,
# GET /.well-known/jwks.json (RFC 8615, not under API_PREFIX). A secret: inject
# it, never commit it. Generate one
# e.g. with `step crypto jwk create pub.json priv.json --kty EC --crv P-256
# --no-password --insecure` and set `jq -c . priv.json`
# [required unless RECEIPTS_EPHEMERAL_SIGNING_KEY=true]
# RECEIPTS_SIGNING_KEY=

# Generate a throwaway receipt signing key at startup when RECEIPTS_SIGNING_KEY
# is unset; receipts it signed stop verifying on restart. Dev only
# [optional, default: false; the dev environment defaults it to true]
# RECEIPTS_EPHEMERAL_SIGNING_KEY=false

# Public-only JWKS (one line of RFC 7517 JSON, {"keys":[...]}) of the keys
# earlier receipts were signed with. Published after the active key, so a
# receipt saved before a rotation still verifies: on rotating
# RECEIPTS_SIGNING_KEY, append the old key's entry from the published JWKS here.
# Private members fail startup [optional, no default]
# RECEIPTS_RETIRED_VERIFICATION_KEYS=

# Key of the salted HMAC an erased user record keeps in place of its identifier,
# so an operator can confirm that a named person consented without the record
# naming anyone, and without two erased records ever being linkable. Keep it out
# of the database and out of participants' hands; rotating it abandons every
# verifier already written. Unset means erased records carry no verifier at all
# [optional, no default]
# ERASURE_VERIFICATION_SECRET=

# -----------------------------------------------------------------------------
# Identity Provider (OAuth2 / OIDC)
# -----------------------------------------------------------------------------

# The Consent Manager is a stateless OAuth2 *resource server*. It issues no tokens
# and holds no client credentials, so there is deliberately no IDP_CLIENT_ID or
# IDP_CLIENT_SECRET here.
#
# A trusted provider is one `consent-manager.identity-providers.<name>` block. The
# trust list is read ONCE at startup and is immutable for the lifetime of the
# process: adding, removing or re-pointing a provider requires a restart. An empty
# trust list, or one with a blank or malformed entry, aborts startup with a message
# naming the offending property.
#
# Providers are keyed by NAME rather than by list position so that each setting has
# a stable environment-variable spelling:
#
#   CONSENT_MANAGER_IDENTITY_PROVIDERS_<NAME>_ISSUER=...
#
# A provider must be declared in YAML (application.yml declares `primary`) before
# environment variables can fill in its values; an environment variable alone does
# not create a new named entry. See docs/adr/0002-own-identity-provider-registry-on-nimbus.md.
#
# The variables below configure the default `primary` entry. IDP_ISSUER,
# IDP_DISCOVERY_URL and IDP_AUDIENCE are commented out on purpose: leaving them
# unset aborts startup with a message naming the missing property, which is safer
# than a copied .env silently trusting a localhost issuer.

# Issuer URL of the `primary` provider. Set it to exactly the `iss` claim the
# provider stamps into its tokens, which is also the `issuer` field of its
# discovery document; the comparison is byte-for-byte.
# [required in production]
# IDP_ISSUER=http://localhost:8180/realms/consent-manager

# URL of the provider's OpenID discovery document, fetched at startup to find its
# jwks_uri. Configured separately from the issuer because a provider may publish
# its metadata somewhere other than the issuer plus the well-known suffix.
# [required in production]
# IDP_DISCOVERY_URL=http://localhost:8180/realms/consent-manager/.well-known/openid-configuration

# Audience this service expects in the token's `aud` claim [required in production]
# IDP_AUDIENCE=consent-manager

# Accept an `http` (rather than `https`) IDP_ISSUER and IDP_DISCOVERY_URL.
# The discovery document is this service's trust anchor: it names the issuer that is
# verified byte-for-byte and the jwks_uri the signing keys are fetched from. Over
# cleartext anyone on the network path supplies both, so startup aborts on an http URL
# unless this is set. Set it only for a local provider, such as the Keycloak in
# compose.yaml; it is logged at WARN on every startup.
# [optional, default: false - but the `dev` profile defaults it to *true* for the
# local Keycloak, and compose.yaml runs the app with MICRONAUT_ENVIRONMENTS=dev, so
# `docker compose up` enables cleartext transport unless this is set to false here.]
# IDP_ALLOW_INSECURE_TRANSPORT=false

# Tolerance applied to the exp, iat and nbf claims [optional, default: 30s]
# IDP_CLOCK_SKEW=30s

# How long a fetched JWK Set stays usable before it is re-fetched.
#
# One cache is shared by every configured provider - the fetching and caching is
# `micronaut-security-jwt`'s, and its cache is global (see
# docs/adr/0004-delegate-jwks-retrieval-and-caching-to-micronaut-security.md).
#
# It bounds two things at once, and they pull in opposite directions.
#
# Raising it costs availability. There is no refetch when a token presents an unknown key
# identifier, so for up to one TTL after a provider rotates its signing key, EVERY token
# it issues is rejected with a 401 - a full authentication outage for this service, which
# then clears on its own without a restart. Set this to 10m and a key rotation is a
# ten-minute outage.
#
# Lowering it costs almost nothing. In steady state, and for as long as the provider
# answers, this service issues at most one JWK Set request per provider per TTL however
# much traffic arrives, so tokens bearing unknown key identifiers cannot be turned into an
# amplifier pointed at the provider. While a provider's key endpoint is FAILING the cache
# bounds nothing - a failed fetch is never cached - so the request rate in that case is
# held down by a separate, fixed cooldown in `IssuerSignatureVerifier` instead, and this
# setting does not affect it.
# [optional, default: 60s]
# IDP_JWKS_CACHE_TTL=60s

# Claim names are lists of segments, written here comma-separated: `realm_access,roles`
# names the `roles` member of the nested `realm_access` object, while a name that merely
# contains dots (`https://example.com/roles`) is a single segment and carries no comma.
# The reading is fixed by this configuration and never inferred from the token.
# A dot therefore no longer separates segments: `realm_access.roles` names one top-level
# claim nothing emits, which costs every caller their roles, so a single dotted segment
# that is not URI-shaped is reported at WARN on startup.

# Claim carrying the opaque user identifier [optional, default: sub]
# IDP_CLAIM_USER_IDENTIFIER=sub

# Claim carrying the opaque participant identifier [optional, default: participant_id]
# IDP_CLAIM_PARTICIPANT_IDENTIFIER=participant_id

# Claim carrying the token's raw role strings [optional, default: realm_access,roles]
# IDP_CLAIM_ROLES=realm_access,roles

# Raw role strings this provider emits, mapped to the service's roles. Matching is
# exact and case-sensitive. [optional, defaults shown]
# IDP_ROLE_USER=consent-user
# IDP_ROLE_PARTICIPANT=consent-participant
# IDP_ROLE_CATALOG=consent-catalog

# ---------------------------------------------------------------------------
# NOTE ON THE CURRENT STEP
# ---------------------------------------------------------------------------
# Every variable above is read and validated at startup, but the token-validation
# pipeline that consults them lands in steps 3-5 of this ticket. Until then no
# signing key is registered, so NO bearer token authenticates at all - the
# fail-closed direction. A malformed value still aborts startup, so configuring
# these now is safe and forward-looking.

# -----------------------------------------------------------------------------
# Local Keycloak (docker compose only)
# -----------------------------------------------------------------------------
# Consumed solely by the `keycloak` service in compose.yaml. The deployed service
# never reads these; it only ever talks to the issuer configured above.

# Port the local Keycloak listens on [optional, default: 8180]
# KEYCLOAK_PORT=8180

# Port of Keycloak's management interface, which serves /health/ready. The app
# service waits for that endpoint before starting so `docker compose up` reaches a
# usable stack directly - see the note on the app service's depends_on in
# compose.yaml.
# [optional, default: 9000]
# KEYCLOAK_MANAGEMENT_PORT=9000

# Bootstrap admin credentials for the local Keycloak console [optional, default: admin]
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Email / SMTP
# -----------------------------------------------------------------------------

# SMTP server host [required when email notifications are enabled]
# SMTP_HOST=smtp.example.com

# SMTP server port [optional, default: 587]
# SMTP_PORT=587

# SMTP authentication username [required when email notifications are enabled]
# SMTP_USER=

# SMTP authentication password [required when email notifications are enabled]
# SMTP_PASSWORD=

# Sender email address for outgoing notifications [required when email notifications are enabled]
# SMTP_FROM=noreply@example.com
