<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.micronaut.platform</groupId>
        <artifactId>micronaut-parent</artifactId>
        <version>5.2.0</version>
    </parent>

    <groupId>com.seamware</groupId>
    <artifactId>consent-manager</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Consent Manager</name>
    <description>Consent lifecycle management service built on Micronaut</description>

    <properties>
        <!-- Java version -->
        <jdk.version>25</jdk.version>
        <release.version>25</release.version>

        <!-- Application main class for executable JAR packaging -->
        <exec.mainClass>com.seamware.consentmanager.Application</exec.mainClass>

        <!-- Micronaut runtime -->
        <micronaut.runtime>netty</micronaut.runtime>
        <micronaut.test.resources.enabled>false</micronaut.test.resources.enabled>

        <!-- Non-BOM-managed dependency versions -->
        <postgresql.version>42.7.5</postgresql.version>
        <logstash-logback-encoder.version>8.0</logstash-logback-encoder.version>
        <assertj.version>3.26.3</assertj.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <testcontainers-keycloak.version>3.6.0</testcontainers-keycloak.version>
        <wiremock.version>3.10.0</wiremock.version>
        <greenmail.version>2.1.3</greenmail.version>
        <lombok.version>1.18.48</lombok.version>
        <json-canonicalization.version>1.1</json-canonicalization.version>

        <!-- OpenAPI Generator and generated-code dependencies -->
        <openapi.generator.version>7.12.0</openapi.generator.version>
        <swagger-annotations.version>2.2.28</swagger-annotations.version>
        <swagger-parser.version>2.1.38</swagger-parser.version>
        <openapi.bundle.directory>${project.build.directory}/openapi-bundle</openapi.bundle.directory>
        <openapi.bundle.file>${openapi.bundle.directory}/openapi.yaml</openapi.bundle.file>
        <jackson-databind-nullable.version>0.2.6</jackson-databind-nullable.version>

        <!-- Code coverage -->
        <jacoco.version>0.8.16</jacoco.version>
        <!-- Merged (unit + integration) BUNDLE ratios, each the measured value rounded down to 0.05
             (measured 2026-10-27: LINE 0.627, BRANCH 0.454) -->
        <jacoco.minimum.line-coverage>0.60</jacoco.minimum.line-coverage>
        <jacoco.minimum.branch-coverage>0.45</jacoco.minimum.branch-coverage>

        <!-- Code formatting -->
        <spotless.version>3.10.3</spotless.version>
        <google-java-format.version>1.36.1</google-java-format.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Testcontainers BOM for consistent version management -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ===== Compile Dependencies ===== -->

        <!-- Lombok: accessor boilerplate on the configuration beans. Compile-time only -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Micronaut HTTP Server (Netty) -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-http-server-netty</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Micronaut HTTP Client -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-http-client</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Micronaut Data JDBC -->
        <dependency>
            <groupId>io.micronaut.data</groupId>
            <artifactId>micronaut-data-jdbc</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Micronaut JDBC Connection Pool (HikariCP) -->
        <dependency>
            <groupId>io.micronaut.sql</groupId>
            <artifactId>micronaut-jdbc-hikari</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- PostgreSQL JDBC Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway Database Migration -->
        <dependency>
            <groupId>io.micronaut.flyway</groupId>
            <artifactId>micronaut-flyway</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Flyway PostgreSQL Database Support (required since Flyway 10) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Micronaut Validation -->
        <dependency>
            <groupId>io.micronaut.validation</groupId>
            <artifactId>micronaut-validation</artifactId>
            <scope>compile</scope>
        </dependency>

        <!--
            Micronaut Security JWT.

            Brings the security filter, the `@Secured` rules and the token-validation
            SPI this service plugs into. It also owns JWK Set retrieval end to end:
            `JwkSetFetcher` performs the request, `CacheableJwkSetFetcher` caches the
            result in the Micronaut Cache named `jwks`, and `ReactiveJwksSignature`
            matches the token's `kid` and verifies the signature. This service
            configures those components per trusted provider and writes none of them;
            the reasoning is recorded in
            docs/adr/0004-delegate-jwks-retrieval-and-caching-to-micronaut-security.md.
        -->
        <dependency>
            <groupId>io.micronaut.security</groupId>
            <artifactId>micronaut-security-jwt</artifactId>
            <scope>compile</scope>
        </dependency>

        <!--
            Micronaut Security OAuth2.

            Supplies the OpenID Connect part: `OpenIdProviderMetadataFetcher` performs
            the discovery request and `DefaultOpenIdProviderMetadata` models the
            provider metadata document, so this service composes no discovery URL,
            issues no discovery request and parses no discovery document of its own.
            `IdentityProviderRegistry` drives that fetcher; the reasoning is recorded in
            docs/adr/0003-use-micronaut-security-oauth2-for-openid-discovery.md.
        -->
        <dependency>
            <groupId>io.micronaut.security</groupId>
            <artifactId>micronaut-security-oauth2</artifactId>
            <scope>compile</scope>
        </dependency>

        <!--
            Micronaut Cache (Caffeine).

            Also the cache behind JWK Set retrieval: declaring `micronaut.caches.jwks`
            is what switches `micronaut-security-jwt` to its cacheable fetcher, so this
            is a functional dependency of token validation, not only of application
            caching.
        -->
        <dependency>
            <groupId>io.micronaut.cache</groupId>
            <artifactId>micronaut-cache-caffeine</artifactId>
            <scope>compile</scope>
        </dependency>

        <!--
            Micronaut Retry.

            `@Retryable` and the `RetryPredicate` SPI live here, and the module is what
            registers the interceptor that applies them. The Contract Service client is
            the only retrying caller: a 5xx or a timeout from it is a transient outage
            worth a second attempt, while a 4xx is a defect retrying would only multiply.
        -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-retry</artifactId>
            <scope>compile</scope>
        </dependency>

        <!--
            Micronaut Reactor.

            The reactive SPIs this service implements and consumes - `TokenValidator`,
            `ReactiveSignatureConfiguration`, `HealthIndicator` - are declared in terms
            of `Publisher`, and composing one without a reactive library means
            hand-writing subscribers. Reactor is already on the runtime classpath as a
            transitive dependency of the HTTP client; declaring it explicitly makes it
            available at compile time and stops an unrelated upgrade from removing it.
        -->
        <dependency>
            <groupId>io.micronaut.reactor</groupId>
            <artifactId>micronaut-reactor</artifactId>
            <scope>compile</scope>
        </dependency>

        <!--
            Nimbus JOSE + JWT.

            Declared explicitly because this service names `SignedJWT`, `JWKSet` and
            `JWK` in its own sources. It arrives transitively through
            `micronaut-security-jwt` as well; relying on that would let a change in
            that module's dependencies break this build with no change here.
        -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <scope>compile</scope>
        </dependency>

        <!--
            RFC 8785 (JCS) canonicalization of the receipt bytes a detached JWS signs, so a
            verifier holding only the JSON it was served can recompute the exact payload.
        -->
        <dependency>
            <groupId>io.github.erdtman</groupId>
            <artifactId>java-json-canonicalization</artifactId>
            <version>${json-canonicalization.version}</version>
        </dependency>

        <!-- Micronaut Management Endpoints -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-management</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Micrometer Prometheus Registry -->
        <dependency>
            <groupId>io.micronaut.micrometer</groupId>
            <artifactId>micronaut-micrometer-registry-prometheus</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Micronaut Email (JavaMail) -->
        <dependency>
            <groupId>io.micronaut.email</groupId>
            <artifactId>micronaut-email-javamail</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.micronaut.email</groupId>
            <artifactId>micronaut-email-template</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- The SMTP transport behind the jakarta.mail API; without it every send fails -->
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Thymeleaf views: renders the notification email templates -->
        <dependency>
            <groupId>io.micronaut.views</groupId>
            <artifactId>micronaut-views-thymeleaf</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Micronaut Serde (Jackson) -->
        <dependency>
            <groupId>io.micronaut.serde</groupId>
            <artifactId>micronaut-serde-jackson</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- SnakeYAML: required for Micronaut to load application.yml config files, and
             used by the specification tests to parse the served OpenAPI documents. A single
             runtime-scoped declaration covers both: runtime scope is on the test classpath,
             and it is the scope that packages the parser into the runnable jar. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Micronaut OpenTelemetry Tracing (HTTP server and client instrumentation) -->
        <dependency>
            <groupId>io.micronaut.tracing</groupId>
            <artifactId>micronaut-tracing-opentelemetry-http</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- OpenTelemetry OTLP Exporter (sends traces to an OTel Collector) -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Logback Classic (structured logging runtime) -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Logstash Logback Encoder (JSON structured logging). Compile scope: the lifecycle
             seam (ConsentStateChangeLog) uses StructuredArguments to emit named JSON fields. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-logback-encoder.version}</version>
        </dependency>

        <!-- ===== OpenAPI Generated Code Dependencies ===== -->
        <!-- Swagger v3 annotations (@Schema, @Operation, etc.) required by generated code.
             Scope is 'provided' — needed at compile time but NOT shipped at runtime. -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <version>${swagger-annotations.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- JsonNullable, the tri-state wrapper the generator emits for a property declared
             `nullable: true` with `x-is-jackson-optional-nullable`. It is what lets a PATCH
             handler tell "property omitted" from "property explicitly null"; JsonNullableSerde
             teaches micronaut-serde to read and write it. Runtime scope: generated models
             carry it in their field types. -->
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
            <version>${jackson-databind-nullable.version}</version>
        </dependency>

        <!-- ===== Test Dependencies ===== -->

        <!-- Micronaut Test JUnit 5 -->
        <dependency>
            <groupId>io.micronaut.test</groupId>
            <artifactId>micronaut-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit Jupiter -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit Jupiter Parameterized Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- AssertJ Fluent Assertions -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers Core -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers PostgreSQL Module -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers JUnit Jupiter Integration -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers Keycloak Module -->
        <dependency>
            <groupId>com.github.dasniko</groupId>
            <artifactId>testcontainers-keycloak</artifactId>
            <version>${testcontainers-keycloak.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- WireMock for HTTP Service Stubs -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Parses the served bundle as OpenAPI in OpenApiServingIT -->
        <dependency>
            <groupId>io.swagger.parser.v3</groupId>
            <artifactId>swagger-parser-v3</artifactId>
            <version>${swagger-parser.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- In-process SMTP server for the notification ITs -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail-junit5</artifactId>
            <version>${greenmail.version}</version>
            <scope>test</scope>
            <exclusions>
                <!-- Bundles a second, older copy of the jakarta.mail API next to angus-mail -->
                <exclusion>
                    <groupId>org.eclipse.angus</groupId>
                    <artifactId>jakarta.mail</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Micronaut Maven Plugin -->
            <plugin>
                <groupId>io.micronaut.maven</groupId>
                <artifactId>micronaut-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>

            <!-- OpenAPI Generator: generates server interfaces and models from the spec -->
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi.generator.version}</version>
                <executions>
                    <execution>
                        <id>generate-api</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/api/openapi.yaml</inputSpec>
                            <generatorName>java-micronaut-server</generatorName>
                            <output>${project.build.directory}/generated-sources/openapi</output>
                            <apiPackage>com.seamware.consentmanager.api.generated</apiPackage>
                            <modelPackage>com.seamware.consentmanager.api.generated.model</modelPackage>
                            <!--
                                Overrides only server/controller.mustache,
                                common/model/oneof_interface.mustache and
                                common/model/modelInnerEnum.mustache; every other template, and
                                every partial they reference, still resolves against the
                                generator's embedded java-micronaut templates. The controller
                                override exists so a routed method can declare the typed principal
                                parameter that PrincipalResolutionFilter and PrincipalArgumentBinder
                                both require; the oneOf override drops the empty-property
                                @JsonTypeInfo serde cannot write; the enum override makes serde
                                write an enum's value rather than its constant name - see the head
                                of each template.
                            -->
                            <templateDirectory>${project.basedir}/api/templates</templateDirectory>
                            <configOptions>
                                <useBeanValidation>true</useBeanValidation>
                                <!--
                                    A oneOf becomes an interface its members implement, so one
                                    handler can return any representation `format` selects
                                    (ConsentRepresentation). Without it the members are merged into
                                    one model with the union of their properties.
                                -->
                                <useOneOfInterfaces>true</useOneOfInterfaces>
                                <useJakartaEe>true</useJakartaEe>
                                <serializationLibrary>micronaut_serde_jackson</serializationLibrary>
                                <generateControllerFromExamples>false</generateControllerFromExamples>
                                <generateControllerAsAbstract>true</generateControllerAsAbstract>
                                <reactive>false</reactive>
                                <!--
                                    Every handler returns HttpResponse<T> so an operation that
                                    varies its success status (201 vs 200 on registration, 204,
                                    207) can set it. Applied generator-wide rather than per
                                    operation because the generator has no per-operation switch.
                                -->
                                <wrapInHttpResponse>true</wrapInHttpResponse>
                            </configOptions>
                            <!--
                                RFC 7807 makes `instance` a URI reference, usually relative; the
                                generator would otherwise type uri-reference as String. The mapping
                                is global: every uri-reference property becomes java.net.URI.
                            -->
                            <typeMappings>
                                <typeMapping>string+uri-reference=URI</typeMapping>
                            </typeMappings>
                            <!-- Suppress generated Application.java and other scaffolding — we manage them ourselves -->
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Java Compiler with Micronaut Annotation Processors -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        Declared in full rather than appended to the parent's list, because the
                        order matters: Lombok writes the accessors of a @ConfigurationProperties
                        bean into the AST, and micronaut-inject-java only binds the ones it can
                        see, so Lombok has to run first. Appending would place it last and leave
                        the configuration beans silently unbound.
                        ConsentManagerConfigurationTest fails the build if that ever regresses.
                    -->
                    <annotationProcessorPaths combine.children="override">
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>io.micronaut</groupId>
                            <artifactId>micronaut-inject-java</artifactId>
                            <version>${micronaut.core.version}</version>
                        </path>
                        <path>
                            <groupId>io.micronaut.validation</groupId>
                            <artifactId>micronaut-validation-processor</artifactId>
                        </path>
                        <path>
                            <groupId>io.micronaut.data</groupId>
                            <artifactId>micronaut-data-processor</artifactId>
                        </path>
                        <path>
                            <groupId>io.micronaut.serde</groupId>
                            <artifactId>micronaut-serde-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Unit Tests (Surefire) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!-- Integration Tests (Failsafe) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- OpenApiServingIT compares the served spec against this file. -->
                    <systemPropertyVariables>
                        <openapi.bundle.file>${openapi.bundle.file}</openapi.bundle.file>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!--
                Bundle api/ into one document with no external $ref. A SnakeYAML pass, not the
                generator's openapi-yaml target or swagger-parser: both hoist inline schemas
                into invented components, reorder keys and leave nested relative refs dangling.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bundle-openapi-spec</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <classpathScope>runtime</classpathScope>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath />
                                <argument>${project.basedir}/src/build/java/OpenApiBundler.java</argument>
                                <argument>${project.basedir}/api/openapi.yaml</argument>
                                <argument>${openapi.bundle.file}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Publish the bundle as the one specification the service serves -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-openapi-bundle</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${openapi.bundle.directory}</directory>
                                    <includes>
                                        <include>openapi.yaml</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- What the jar and image ship besides our classes; ProductionArtefactTest reads it -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>list-runtime-dependencies</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>list</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputFile>${project.build.directory}/runtime-dependencies.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- JaCoCo: code coverage measurement and enforcement -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <!-- Plugin-level so report and check measure the same classes; the agent
                     executions override it so no `$`/`*` pattern reaches the forked argLine -->
                <configuration>
                    <excludes>
                        <exclude>com/seamware/consentmanager/api/generated/**</exclude>
                        <!-- Micronaut's compile-time bean definitions, introspections and AOP proxies -->
                        <exclude>**/$*Definition*</exclude>
                        <exclude>**/$*Introspection*</exclude>
                        <exclude>**/$*Intercepted*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- Prepare the JaCoCo agent for unit tests (Surefire) -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <excludes combine.self="override"/>
                        </configuration>
                    </execution>
                    <!-- Prepare the JaCoCo agent for integration tests (Failsafe) -->
                    <execution>
                        <id>prepare-agent-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <configuration>
                            <excludes combine.self="override"/>
                        </configuration>
                    </execution>
                    <!-- Merge unit and integration test execution data -->
                    <execution>
                        <id>merge-results</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                        <include>jacoco-it.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                        </configuration>
                    </execution>
                    <!-- Generate a combined coverage report during the verify phase -->
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                        </configuration>
                    </execution>
                    <!-- Enforce minimum coverage threshold -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.line-coverage}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.branch-coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Spotless: source code formatting using Google Java Format -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports />
                        <trimTrailingWhitespace />
                        <endWithNewline />
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
