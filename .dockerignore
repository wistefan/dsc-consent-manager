# =============================================================================
# Consent Manager — Docker Build Context Exclusions
# =============================================================================
# Exclude files not needed inside the Docker build to speed up context
# transfer and avoid leaking sensitive data into images.
# =============================================================================

# Version control
.git
.gitignore

# Build output (rebuilt inside Docker)
target/

# Key material, at any depth. Patterns anchor at the context root, so a bare
# `*.jwk` would miss src/main/resources/x.jwk, which `COPY src/` bakes into the JAR.
**/*.pem
**/*.key
**/*.jwk
**/*.jwks
**/keys/

# Test sources and resources (tests run in CI, not in the image build)
src/test/

# Environment files (may contain secrets)
.env
.env.*
!.env.sample

# IDE files
.idea/
*.iml
.vscode/
.project
.classpath
.settings/
nbproject/
out/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Docker files (not needed inside the build)
docker/
compose.yaml
.dockerignore

# Helm chart (deployed separately, never part of the image)
charts/

# Documentation
*.md
LICENSE

# CI/CD configuration
.github/
.gitlab-ci.yml
Jenkinsfile
